# KutyAI ortam degiskenleri
# Bu dosyayi .env olarak kopyalayin: cp .env.ornek .env

# --- Ortam ---
# gelistirme | test | uretim
KUTYAI_ORTAM=gelistirme

# --- Veritabani ---
# Bos birakilirsa SQLite kullanilir: bdm_veritabani/kutyai.db
KUTYAI_VERITABANI_URL=
# PostgreSQL ornegi:
# KUTYAI_VERITABANI_URL=postgresql+asyncpg://kutyai:kutyai@localhost:5432/kutyai

# --- Guvenlik (uretimde ZORUNLU) ---
# Uretimde bu degerler bos birakilirsa uygulama baslamaz.
KUTYAI_GIZLI_ANAHTAR=
# Fernet anahtari uret: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KUTYAI_SIFRELEME_ANAHTARI=
KUTYAI_ERISIM_OMRU_DK=15
KUTYAI_YENILEME_OMRU_GUN=30

# --- Arayuzler ---
KUTYAI_ONUC_URL=http://localhost:3000
KUTYAI_PANEL_URL=http://localhost:3001
KUTYAI_CORS_KAYNAKLAR=http://localhost:3000,http://localhost:3001

# --- Loglama ve KVKK ---
KUTYAI_SAKLAMA_GUN=90
KUTYAI_MASKELEME_AKTIF=true
KUTYAI_ORAN_SINIRI_ISTEK_DK=60
# Kimlik uclarinda (giris/kayit/sifre sifirlama) IP basina dakikalik deneme siniri
KUTYAI_ORAN_SINIRI_KIMLIK_DK=10
# Ters vekil arkasinda gercek istemci IP'si icin X-Forwarded-For'a guven.
# Yalnizca vekil sizin kontrolunuzdeyse true yapin; aksi halde sahtelenebilir.
KUTYAI_GUVENILIR_VEKIL=false

# --- E-posta (bos ise konsol surucusu kullanilir) ---
KUTYAI_SMTP_HOST=
KUTYAI_SMTP_PORT=587
KUTYAI_SMTP_KULLANICI=
KUTYAI_SMTP_SIFRE=
KUTYAI_SMTP_GONDEREN=KutyAI <bildirim@kutyai.local>
KUTYAI_SMTP_TLS=true

# --- Konteyner orkestrasyonu ---
KUTYAI_DOCKER_SOKETI=
KUTYAI_IMAGE_ONBELLEK=vllm/vllm-openai:latest,ollama/ollama:latest
# HuggingFace model onbellegi (bos ise bdm_veritabani/hf-onbellek).
# vLLM/TGI konteynerlerine bu dizin baglanir; "Hazirlama > Modeli indir" buraya indirir.
KUTYAI_HF_ONBELLEK=

# --- Dosya yukleme (v2) ---
KUTYAI_DOSYA_MAKS_MB=25
# Bos ise bdm_veritabani/dosyalar
KUTYAI_DOSYA_DIZINI=
KUTYAI_DOSYA_BAGLAM_KR=12000

# --- Arac cagirma (v2) ---
# Webhook imza anahtari (bos ise JWT gizli anahtari kullanilir)
KUTYAI_ARAC_IMZA_ANAHTARI=
# Yerel aga http webhook'a izin ver (uretimde false tutun)
KUTYAI_ARAC_YEREL_IZIN=false
KUTYAI_ARAC_MAKS_TUR=4

# --- RAG (v2) ---
KUTYAI_RAG_UST_K=4

# --- Odeme (v2): yerel | stripe ---
KUTYAI_ODEME_SAGLAYICI=yerel
KUTYAI_STRIPE_GIZLI_ANAHTAR=
KUTYAI_STRIPE_WEBHOOK_SIRRI=

# --- SSO (v2) ---
KUTYAI_SSO_OTOMATIK_UYELIK=true
# Basarili girisde yonlendirilecek adres (bos ise onuc /sohbet)
KUTYAI_SSO_YENIDEN_YONLENDIRME=
