# KutyAI — yonetim_paneli uretim imaji; cok asamali.
# Baglam: depo koku (docker-compose.yml -> context: ..), dosya: dagitim/Dockerfile.panel
#
#   docker build -f dagitim/Dockerfile.panel --build-arg NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1 -t kutyai/yonetim-paneli:0.1.0 .

# --- 1) Derleme asamasi -------------------------------------------------------
FROM node:22-alpine AS derleme
WORKDIR /uygulama
ENV NEXT_TELEMETRY_DISABLED=1

COPY yonetim_paneli/package.json yonetim_paneli/package-lock.json ./
RUN npm ci

COPY yonetim_paneli/ ./

# Tarayicidan gorunen API adresi (derleme aninda gomulur).
ARG NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm run build

# --- 2) Uretim asamasi --------------------------------------------------------
FROM node:22-alpine AS uretim
WORKDIR /uygulama
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3001

# Yalnizca calisma zamani bagimliliklari; npm onbellegi ve kullanilmayan gnu
# SWC ikilisi cikarilir (Alpine musl kullanir).
COPY yonetim_paneli/package.json yonetim_paneli/package-lock.json ./
RUN npm ci --omit=dev \
 && rm -rf /root/.npm node_modules/@next/swc-linux-x64-gnu node_modules/@next/swc-linux-arm64-gnu

COPY --from=derleme /uygulama/.next ./.next
COPY --from=derleme /uygulama/next.config.ts ./next.config.ts

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=20s \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# package.json: "start": "next start -p 3001"
CMD ["npm", "run", "start"]
