# KutyAI — onuc (son kullanici arayuzu) uretim imaji; cok asamali.
# Baglam: depo koku (docker-compose.yml -> context: ..), dosya: dagitim/Dockerfile.onuc
#
#   docker build -f dagitim/Dockerfile.onuc --build-arg NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1 -t kutyai/onuc:0.1.0 .

# --- 1) Derleme asamasi -------------------------------------------------------
FROM node:22-alpine AS derleme
WORKDIR /uygulama
ENV NEXT_TELEMETRY_DISABLED=1

# Once yalnizca manifestler: bagimlilik katmani onbelleklenir.
COPY onuc/package.json onuc/package-lock.json ./
RUN npm ci

COPY onuc/ ./

# NEXT_PUBLIC_* degerleri derleme aninda istemci paketine gomulur; bu yuzden
# tarayicidan gorunen adres olmalidir (http://localhost:8000/api/v1).
ARG NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm run build

# --- 2) Uretim asamasi --------------------------------------------------------
FROM node:22-alpine AS uretim
WORKDIR /uygulama
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

# Yalnizca calisma zamani bagimliliklari. npm onbellegi ve Alpine'de (musl)
# kullanilmayan gnu SWC ikilisi imajdan cikarilir: ~310 MB tasarruf.
COPY onuc/package.json onuc/package-lock.json ./
RUN npm ci --omit=dev \
 && rm -rf /root/.npm node_modules/@next/swc-linux-x64-gnu node_modules/@next/swc-linux-arm64-gnu

# Derlenmis cikti + Next yapilandirmasi (next start bu dosyayi okur).
COPY --from=derleme /uygulama/.next ./.next
COPY --from=derleme /uygulama/next.config.ts ./next.config.ts

EXPOSE 3000

# Kok sayfa /giris'e yonlendirir; fetch yonlendirmeyi izler ve 200 bekler.
HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=20s \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npm", "run", "start"]
