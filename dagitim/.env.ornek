# KutyAI ortam degiskenleri (dagitim/.env.ornek)
#
# Bu dosyayi .env olarak kopyalayin:
#   cp .env.ornek .env        # ya da baslat betigi bunu kendisi yapar ve sirlari uretir
#   .\baslat.ps1              # Windows
#   ./baslat.sh               # Linux/macOS
#
# Kok dizindeki .env.ornek ile ayni degiskenleri tasir; Docker dagitimi icin
# yalnizca asagidaki ek degerler ve varsayilan yollar farklidir.
# Docker Compose bu dosyayi hem degisken yerine koyma (interpolation) icin
# hem de arkauc konteynerine env_file olarak okur.

# --- Ortam ---
# gelistirme | test | uretim
# URETIM: `uretim` secin; asagidaki iki sir bos kalirsa uygulama BASLAMAZ.
KUTYAI_ORTAM=gelistirme

# --- Veritabani ---
# Bos birakilirsa SQLite kullanilir ve adlandirilmis volume'e yazilir:
#   sqlite+aiosqlite:////veri/kutyai.db        (kutyai-veri volume'u)
# PostgreSQL profili icin (docker compose --profile postgres):
#   KUTYAI_VERITABANI_URL=postgresql+asyncpg://kutyai:kutyai@postgres:5432/kutyai
# baslat.ps1 -Profil postgres / baslat.sh --profil postgres bu degeri kendisi verir.
KUTYAI_VERITABANI_URL=

# --- Guvenlik (uretimde ZORUNLU) ---
# Gizli anahtar uret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
KUTYAI_GIZLI_ANAHTAR=
# Fernet anahtari uret: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KUTYAI_SIFRELEME_ANAHTARI=
KUTYAI_ERISIM_OMRU_DK=15
KUTYAI_YENILEME_OMRU_GUN=30

# --- Arayuzler ---
# Tarayicidan gorunen adresler (konteyner ici degil, kullanicinin actigi adres).
KUTYAI_ONUC_URL=http://localhost:3000
KUTYAI_PANEL_URL=http://localhost:3001
# CORS: arayuzlerin API'ye hangi adreslerden erisebilecegi.
KUTYAI_CORS_KAYNAKLAR=http://localhost:3000,http://localhost:3001

# --- Loglama ve KVKK ---
KUTYAI_SAKLAMA_GUN=90
KUTYAI_MASKELEME_AKTIF=true
KUTYAI_ORAN_SINIRI_ISTEK_DK=60
# Kimlik uclarinda (giris/kayit/sifre sifirlama) IP basina dakikalik deneme siniri
KUTYAI_ORAN_SINIRI_KIMLIK_DK=10

# --- E-posta (bos ise konsol surucusu kullanilir) ---
KUTYAI_SMTP_HOST=
KUTYAI_SMTP_PORT=587
KUTYAI_SMTP_KULLANICI=
KUTYAI_SMTP_SIFRE=
KUTYAI_SMTP_GONDEREN=KutyAI <bildirim@kutyai.local>
KUTYAI_SMTP_TLS=true

# --- Konteyner orkestrasyonu ---
# Bos ise docker.from_env() kullanilir: soket /var/run/docker.sock (compose baglar).
KUTYAI_DOCKER_SOKETI=
KUTYAI_IMAGE_ONBELLEK=vllm/vllm-openai:latest,ollama/ollama:latest
# HuggingFace model onbellegi. Bos birakilirsa konteyner ici varsayilan kullanilir
# (/uygulama/bdm_veritabani/hf-onbellek) — volume'de DEGILDIR, konteyner yeniden
# olusturulunca indirilen modeller kaybolur.
# ONEMLI (Docker dagitimi): bu yol BDM konteynerlerine baglanmak uzere DOCKER
# HOST uzerinde aranir. Bu nedenle ayni dizini arkauc konteynerine de ayni yoldan
# baglayin; ornek (docker-compose.yml icinde yorumlu):
#   KUTYAI_HF_ONBELLEK=/srv/kutyai/hf-onbellek
#   volumes: ["/srv/kutyai/hf-onbellek:/srv/kutyai/hf-onbellek"]
KUTYAI_HF_ONBELLEK=

# --- Yalnizca Docker dagitimi ---
# Tarayicidan gorunen API adresi; NEXT_PUBLIC_API_URL olarak derleme aninda gomulur
# ve calisma zamaninda da verilir. Uzak sunucuda alan adiyla degistirin
# ornek: KUTYAI_TARAYICI_API_URL=https://kutyai.example.com/api/v1
KUTYAI_TARAYICI_API_URL=http://localhost:8000/api/v1

# PostgreSQL profili kimlik bilgileri (yalnizca --profile postgres ile kullanilir).
# KUTYAI_VERITABANI_URL icindeki kullanici/parola ile AYNI olmalidir.
KUTYAI_POSTGRES_VERITABANI=kutyai
KUTYAI_POSTGRES_KULLANICI=kutyai
KUTYAI_POSTGRES_PAROLA=kutyai
